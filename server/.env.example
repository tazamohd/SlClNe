# SALIS AUTO server configuration. Copy to `.env` and adjust. NO REAL SECRETS HERE.

# HTTP port the API listens on. Frontend uses VITE_API_BASE_URL=http://localhost:4000
PORT=4000

# CORS allow-list (comma-separated origins). Defaults to the Vite dev server.
CORS_ORIGIN=http://localhost:5173

# JWT signing secret. MUST be overridden in any real deployment.
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600

# Demo login password shared by every seeded role account (dev convenience only).
DEMO_PASSWORD=salis1234

# Database driver:
#   - Leave DATABASE_URL unset  -> zero-setup in-memory Postgres (PGlite). Great for
#     `npm run dev`, tests, and reviewers with nothing installed.
#   - Set DATABASE_URL          -> real Postgres via node-postgres (pg).
# DATABASE_URL=postgres://user:pass@localhost:5432/salis
