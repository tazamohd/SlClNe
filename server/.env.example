# SALIS AUTO API — copy to .env and fill in locally.
# Values are never committed. Every secret is read from the environment; there
# is no fallback literal in the source, so a missing one fails at boot rather
# than running with a guessable default.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# PostgreSQL 16. The application connects as a NON-superuser role: row-level
# security is bypassed by superusers, so a superuser DSN silently disables
# tenant isolation.
DATABASE_URL=postgres://salis_app:change-me@localhost:5432/salis_auto
# Used only by scripts/migrate.ts, which must own the tables it creates.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/salis_auto
DATABASE_POOL_MAX=10

# Access-token signing and verification. The same HS256 secret does both in
# development; production should move to an asymmetric key with JWKS so the API
# can verify without holding the ability to sign.
JWT_SECRET=
JWT_ISSUER=salis-auto
JWT_AUDIENCE=salis-auto-api

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Requests per minute per IP before 429. /auth/login, the OTP routes and
# password recovery carry tighter per-route budgets of their own.
RATE_LIMIT_MAX=300

# ── Authentication (src/auth) ────────────────────────────────────────────────
# Argon2id cost. Defaults are the OWASP Password Storage figures (m = 19 MiB,
# t = 2, p = 1). Raising them is safe: an existing hash carrying weaker
# parameters is upgraded on its owner's next successful sign-in.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Token lifetimes. The access token is a bearer credential and is not
# revocable, which is why it is short; the refresh token names a session row
# that can be revoked, which is why it can be long.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# One-time codes. 60s resend throttle is handoff/README.md §6b.
OTP_RESEND_SECONDS=60
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# unconfigured | log | memory. The default REFUSES to send: there is no SMS or
# email provider wired up, and an endpoint that returns 200 for a message it
# never sent is worse than one that fails. `log` writes the code to the server
# log and labels itself a development transport on every send.
OTP_TRANSPORT=unconfigured

PASSWORD_RESET_TTL_MINUTES=30

# Per-minute budgets for the unauthenticated auth endpoints, on top of
# RATE_LIMIT_MAX. Sign-in is the tighter of the two.
AUTH_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Failed sign-ins from one email+IP before a lockout, and how long it lasts.
# Enforced per process — with more than one instance this is a speed bump on
# top of the rate limiter, not a distributed lockout.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300

# Enterprise SSO and WebAuthn. NO ADAPTER IS IMPLEMENTED: setting these does
# not switch a provider on. The routes answer 503 naming what is missing, and
# GET /api/v1/auth/providers reports the state of each one.
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# The OBD bridge — the on-prem service that talks to a scan tool in a bay.
# NO LIVE ADAPTER IS IMPLEMENTED: 'unconfigured' (default) refuses device
# commands with a 503, 'mock' returns deterministic responses flagged as a mock.
# Even a populated URL/token stays unconfigured until a live adapter ships, so a
# scan is never faked. GET /api/v1/diagnostics/integrations reports the state.
OBD_TRANSPORT=unconfigured
OBD_BRIDGE_URL=
OBD_BRIDGE_TOKEN=
