# SALIS AUTO API — copy to .env and fill in locally.
# Values are never committed. Every secret is read from the environment; there
# is no fallback literal in the source, so a missing one fails at boot rather
# than running with a guessable default.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# PostgreSQL 16. The application connects as a NON-superuser role: row-level
# security is bypassed by superusers, so a superuser DSN silently disables
# tenant isolation.
DATABASE_URL=postgres://salis_app:change-me@localhost:5432/salis_auto
# Used only by scripts/migrate.ts, which must own the tables it creates.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/salis_auto
DATABASE_POOL_MAX=10

# Access-token verification. Agent 06 owns issuing; this server only verifies.
# HS256 shared secret in development, JWKS in production.
JWT_SECRET=
JWT_ISSUER=salis-auto
JWT_AUDIENCE=salis-auto-api

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Requests per minute per IP before 429.
RATE_LIMIT_MAX=300
