      "app/src/data/useCollection.ts",
      "app/src/data/rbac.ts",
      "app/src/data/types.ts",
      "app/src/data/registry-types.ts",
      "app/src/styles/tokens/**",
      "app/tailwind.config.js",
      "app/package.json",
      "server/drizzle/**",
      "packages/contract/**",
      "project-control/**"
    ],
    "rule": "Open a request in BLOCKERS.json rather than editing directly. Agent 01 batches these so two agents never rewrite the router in the same hour. As of W2 a product agent has no reason to touch routes/index.tsx at all: it declares its screens in its own barrel under app/src/screens/domains/, which the router composes and which nobody else edits. Adding a domain is one orchestrator edit, written once."
