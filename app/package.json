{
  "name": "salis-auto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "port-design": "node scripts/port-design-data.mjs",
    "registry": "node scripts/build-registry.mjs",
    "expand-assertions": "node scripts/expand-smoke-assertions.mjs",
    "check-no-fake": "node scripts/check-no-fake.mjs",
    "check-tokens": "node scripts/check-tokens.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "check-a11y": "node scripts/check-a11y.mjs",
    "gates": "npm run registry && npm run expand-assertions && npm run check-no-fake && npm run check-tokens && npm run check-i18n && npm run check-a11y",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "certify": "npm run registry && node scripts/check-no-fake.mjs --strict && node scripts/check-tokens.mjs --strict",
    "check-bundle": "node scripts/check-bundle.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify:api": "node scripts/verify-live-api.mjs",
    "lint:css": "node scripts/check-logical-css.mjs",
    "lint:a11y": "node scripts/check-a11y-copy.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
