{
  "buildCommand": "cd app && npm install && npm run build",
  "outputDirectory": "app/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/2060", "destination": "/2060/index.html" },
    { "source": "/2060/", "destination": "/2060/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
